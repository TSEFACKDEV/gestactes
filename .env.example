# ============================================================
# GestActes — variables d'environnement
# Copier ce fichier vers .env puis remplacer les secrets.
# Ne jamais committer .env.
# ============================================================

# --- Application ---
ENVIRONMENT=dev
APP_NAME=GestActes API
API_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:8080

# --- Base de données ---
POSTGRES_DB=gestactes
POSTGRES_USER=gestactes
POSTGRES_PASSWORD=gestactes
DATABASE_URL=postgresql+psycopg://gestactes:gestactes@db:5432/gestactes

# --- Authentification ---
JWT_SECRET=remplacer-par-un-secret-long-et-aleatoire
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# --- GitHub ---
GITHUB_API_URL=https://api.github.com
GITHUB_REPO=owner/gestactes-data
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=remplacer-par-un-secret-de-webhook

# --- SMTP ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@gestactes.local

# --- Uploads ---
MAX_UPLOAD_MB=5
MAX_FILES=3

# --- Données de démonstration ---
# Charge automatiquement le jeu de démonstration (idempotent).
AUTO_SEED=true
SEED_PASSWORD=Demo1234!
